# =============================================================================
# ELI5 Chatbot - Environment Configuration
# =============================================================================
# SECURITY: Copy this file to .env and fill in your values
# NEVER commit your .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# AI PROVIDER CONFIGURATION
# -----------------------------------------------------------------------------
# Choose your AI provider: 'openai', 'gemini', or 'claude'
# If not set, the app will auto-detect based on which API key is provided
# Priority: Claude > Gemini > OpenAI
# AI_PROVIDER=claude

# -----------------------------------------------------------------------------
# OpenAI Configuration (Option 1)
# -----------------------------------------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
# SECURITY: Keep this secret! Never share or commit this key.
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: Specify the model (default: gpt-3.5-turbo)
# Options: gpt-3.5-turbo, gpt-4, gpt-4-turbo, gpt-4o, gpt-4o-mini
# OPENAI_MODEL=gpt-3.5-turbo

# -----------------------------------------------------------------------------
# Google AI Studio / Gemini Configuration (Option 2)
# -----------------------------------------------------------------------------
# Get your API key from: https://aistudio.google.com/app/apikey
# SECURITY: Keep this secret! Never share or commit this key.
# GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Specify the model (default: gemini-1.5-flash)
# Options: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash-exp
# GEMINI_MODEL=gemini-1.5-flash

# -----------------------------------------------------------------------------
# Anthropic Claude Configuration (Option 3) - RECOMMENDED
# -----------------------------------------------------------------------------
# Get your API key from: https://console.anthropic.com/settings/keys
# SECURITY: Keep this secret! Never share or commit this key.
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Optional: Specify the model (default: claude-3-5-sonnet-20241022)
# Options: claude-3-5-sonnet-20241022, claude-3-haiku-20240307, claude-3-opus-20240229
# CLAUDE_MODEL=claude-3-5-sonnet-20241022

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# Port for the backend server (default: 3001)
PORT=3001

# Environment: development | production
NODE_ENV=development

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
# In production, set this to your actual domain(s)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Proxy/Load Balancer Configuration
# -----------------------------------------------------------------------------
# Set to 'true' if running behind a trusted reverse proxy
# This enables X-Forwarded-For header parsing for accurate IP detection
TRUST_PROXY=false

# -----------------------------------------------------------------------------
# Development Options
# -----------------------------------------------------------------------------
# Skip rate limiting in development (NOT recommended for production!)
# SKIP_RATE_LIMIT=true
